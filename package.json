{
  "name": "quartermaster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An agent that proves its fix before it asks to publish it. Built on TrueForge.",
  "scripts": {
    "forge": "npx @truefoundry/trueforge",
    "agents:apply": "tsx scripts/apply-agents.ts",
    "agents:dry": "tsx scripts/apply-agents.ts --dry-run",
    "tools:audit": "node scripts/audit-tools.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test": "node --test scripts/lib/*.test.mjs",
    "agent": "node scripts/run.mjs",
    "agent:resume": "node scripts/run.mjs --resume",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "check": "npm run typecheck && npm test && npm run fixtures:check",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-agents.mjs"
  },
  "dependencies": {
    "@truefoundry/trueforge-sdk": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
