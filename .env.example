# Local TrueForge server (npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://localhost:8790

# Model FQN as configured under Settings -> Models, e.g. openai/gpt-5-5 or anthropic/claude-sonnet-4-6 (dashes, not dots)
TRUEFORGE_MODEL=

# No provider keys belong in this file. Model, Daytona, and GitHub credentials are configured
# in the TrueForge UI and stay in the harness - never in the agent spec, never in the repo.

# Tracing is off unless this is set. One OTLP/JSON line per run into evidence/traces.jsonl, which
# an OpenTelemetry Collector reads with otlpjsonfilereceiver. Nothing is posted to a network, and
# no other variable turns it on. See the Development section of the README.
# QUARTERMASTER_OTEL=1
